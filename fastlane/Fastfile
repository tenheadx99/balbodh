require 'fileutils'

default_platform(:android)

platform :android do
  desc "Build signed release AAB"
  lane :build_signed do
    sh("flutter", "pub", "get")
    sh("flutter", "build", "appbundle", "--release")
  end

  desc "Build signed APK"
  lane :build_signed_apk do
    sh("flutter", "pub", "get")
    sh("flutter", "build", "apk", "--release")
  end

  desc "Sync manually placed screenshots into metadata folders"
  lane :sync_screenshots do
    locales = ["en-US", "de-DE", "es-ES", "fr-FR", "hi-IN"]
    locales.each do |locale|
      src = "screenshots/#{locale}"
      dst = "fastlane/metadata/android/#{locale}/images/phoneScreenshots"
      if Dir.exist?(src)
        FileUtils.mkdir_p(dst)
        Dir.glob("#{src}/*.png").sort.each_with_index do |f, i|
          FileUtils.cp(f, "#{dst}/#{format('%02d', i + 1)}_screenshot.png")
        end
      end
    end
    UI.success("Screenshots synced to metadata folders")
  end

  desc "Deploy to production"
  lane :deploy do
    build_signed
    upload_to_play_store(
      track: "production",
      release_status: "completed",
      skip_upload_apk: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      metadata_path: "fastlane/metadata/android"
    )
  end

  desc "Full deploy to production: build + upload + content rating"
  lane :deploy_all do
    build_signed
    upload_to_play_store(
      track: "production",
      release_status: "completed",
      skip_upload_apk: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      metadata_path: "fastlane/metadata/android"
    )
    submit_content_rating
  end

  desc "Submit content rating questionnaire"
  lane :submit_content_rating do
    supply(
      track: "production",
      json_key: ENV["PLAY_JSON_KEY"],
      content_rating: true,
      content_rating_answers_file: "fastlane/content_rating_answers.json"
    )
  end
end
